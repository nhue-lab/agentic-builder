# ============================================================
# DIRECTIVE OBLIGATOIRE — CLÉS API
# ============================================================
# Avant toute exécution de l'agent, vous DEVEZ configurer
# une clé API Google AI Studio valide ci-dessous.
#
# 📌 Où obtenir une clé gratuite :
#   https://aistudio.google.com/app/apikey
#   → Créer une clé API dans un projet Google Cloud
#   → Le tier gratuit suffit pour tout le développement
#
# 💡 Modèle recommandé pour les tests (tier gratuit) :
#   gemini-2.5-flash-lite (30 RPM, 1M TPM gratuit)
#   gemini-2.5-flash      (10 RPM, 250K TPM gratuit)
#
# ⚠️  Sans GEMINI_API_KEY valide, l'agent tourne en mode
#     simulation (mock). Aucune action réelle n'est exécutée.
# ============================================================

# --- Clé obligatoire (tier gratuit Google AI Studio) ---
GEMINI_API_KEY=your_gemini_api_key_here

# --- Clé optionnelle (modèle de fallback OpenAI) ---
# Laisser vide si vous n'en avez pas.
OPENAI_API_KEY=

# ============================================================
# CONFIGURATION DES MODÈLES
# Recommandation par défaut : Flash Lite pour le développement
# ============================================================
# Agent principal
MODEL=gemini-2.5-flash-lite

# Modèle de fallback (optionnel — commentez si non utilisé)
FALLBACK_MODEL=gemini-2.5-flash

# Modèle du CritiqueAgent (doit rester rapide et économique)
CRITIQUE_MODEL=gemini-2.5-flash-lite

# ============================================================
# RÉGLAGES OPÉRATIONNELS
# ============================================================
TEMPERATURE=0.2
MAX_CONSECUTIVE_ITERATIONS=15
LOG_LEVEL=INFO

# Trajectoires JSONL activées par défaut
TRAJECTORY_LOGGING_ENABLED=true

# Mémoire épisodique activée par défaut
EPISODIC_MEMORY_ENABLED=true
MEMORY_DB_PATH=.agent/memory.db

# ============================================================
# BOT TELEGRAM & DÉPLOIEMENT RENDER (BACKGROUND WORKER 24/7)
# ============================================================
# Token de Bot créé via @BotFather sur Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Whitelist des IDs / usernames Telegram autorisés (séparés par des virgules)
ALLOWED_TELEGRAM_USERS=123456789,my_telegram_username

# Activer la vérification de déploiement Render
RENDER_DEPLOYMENT_ENABLED=false
